# Credenciais — copie para /etc/inforflow/secrets.env (chmod 600)
# NUNCA commite secrets.env no git

INFORFLOW_API_TOKEN=altere-este-token
INFORFLOW_SNMP_COMMUNITY=altere-a-community-snmp
INFORFLOW_UI_USER=admin
INFORFLOW_UI_PASSWORD=altere-a-senha
INFORFLOW_S3_ACCESS_KEY=sua-access-key
INFORFLOW_S3_SECRET_KEY=sua-secret-key
INFORFLOW_S3_BUCKET=inforflow
INFORFLOW_S3_ENDPOINT=https://s3.eu-amsterdam.megas4.com
INFORFLOW_S3_REGION=eu-amsterdam
INFORFLOW_WEBHOOK_URL=
INFORFLOW_TELEGRAM_TOKEN=
INFORFLOW_TELEGRAM_CHAT=
INFORFLOW_UPTIMEROBOT_API_KEY=sua-api-key-uptimerobot
INFORFLOW_PUBLIC_URL=https://inforflow.infornetmg.com.br

# SSL Let's Encrypt (DNS Cloudflare — zone infornetmg.com.br)
# Crie em Cloudflare: My Profile → API Tokens → Edit zone DNS
INFORFLOW_SSL_EMAIL=admin@infornetmg.com.br
INFORFLOW_CLOUDFLARE_API_TOKEN=

# Uptime Kuma (170.245.127.16)
INFORFLOW_UPTIMEKUMA_URL=http://170.245.127.16:3001
INFORFLOW_UPTIMEKUMA_API_KEY=uk2_sua-chave
INFORFLOW_UPTIMEKUMA_USER=admin-kuma
INFORFLOW_UPTIMEKUMA_PASSWORD=senha-admin-kuma
# Preenchido automaticamente por scripts/setup-uptimekuma.py (monitor Push):
# INFORFLOW_UPTIMEKUMA_PUSH_URL=http://170.245.127.16:3001/api/push/SEU_TOKEN
