[Unit]
Description=Inforflow NetFlow/SNMP Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/html/inforflow
EnvironmentFile=-/etc/inforflow/secrets.env
ExecStart=/var/www/html/inforflow/bin/inforflow-collector
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10
LimitNOFILE=65535
# Permite SO_RCVBUF grande no NetFlow
LimitMEMLOCK=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
